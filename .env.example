NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Public production URL, e.g. https://global-ecommerce-toolkit.vercel.app
APP_URL=

# Shopify app credentials from the Shopify Dev Dashboard.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Base64-encoded 32-byte key used to encrypt Shopify access/refresh tokens at rest.
# Generate locally with: openssl rand -base64 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=
